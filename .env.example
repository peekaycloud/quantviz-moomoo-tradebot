# ==========================================
# Moomoo OpenD Gateway Configuration
# ==========================================
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
# Strictly enforced Paper Trading environment (never change to REAL)
MOOMOO_TRD_ENV=SIMULATE
MOOMOO_TRD_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUINC
MOOMOO_CLI_BIN=~/.moomoo/bin/moomoo
MOOMOO_SIM_ACCOUNT_ID=5829916
# Optional unlock password (only needed for some OpenD configs, not required for SIMULATE)
MOOMOO_UNLOCK_PWD=

# ==========================================
# LLM / AI Decision Engine
# ==========================================
# Supported: openai | gemini | local_quant
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: set OPENAI_BASE_URL for OpenAI-compatible providers (Groq, DeepSeek, OpenRouter, Ollama, etc.)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Trading & Risk Management Guardrails
# ==========================================
EXECUTION_MODE=SEMI_AUTO
WATCHLIST=US.AAPL,US.NVDA,US.MU,US.MSFT,US.TSLA,US.SPY,US.QQQ,US.AMD,US.META,US.AVGO,US.PLTR
MAX_POSITION_PCT=0.05
MAX_SECTOR_PCT=0.20
DAILY_DRAWDOWN_LIMIT_PCT=0.02
DEFAULT_ATR_STOP_MULT=2.0
DEFAULT_RR_TARGET=2.5

# ==========================================
# Backtester Auto-Gatekeeper Thresholds
# ==========================================
MIN_SHARPE_RATIO=1.2
MAX_DRAWDOWN_PCT=0.15
COMMISSION_RATE=0.0005
SLIPPAGE_BPS=5.0

# ==========================================
# Storage & Server
# ==========================================
DUCKDB_PATH=data/tradebot.duckdb
PARQUET_DIR=data/ohlcv
API_HOST=127.0.0.1
API_PORT=8000
POLL_INTERVAL_SECONDS=5
RESEARCH_INTERVAL_SECONDS=300
SEC_EDGAR_USER_AGENT=QuantTradeBot/1.0 (contact@example.com)
